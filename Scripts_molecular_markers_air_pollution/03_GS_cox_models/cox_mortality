      )
    )
}

pollutants1 <- c("PM25d", "NO2d",  "NOd",  "O3d",  "PM10d", "SO2d", "NO3_Cd", "NO3_Fd")


assump_test <- list()
cox_results <- list()
aic_results <- list()

#Run models
for (pollutant in pollutants1) {
    print(pollutant)
    #model list
    formula_list <- list(
      paste("Surv(tte_years, status_mort) ~", pollutant, "+ age + as.factor(sex) + (1|id)"),
      paste("Surv(tte_years, status_mort) ~", pollutant, "+ age + as.factor(sex) + (1|id) + logunits + logbmi + logsmok + simd2009v2rank  + as.factor(diabetes) + as.factor(hypertension)"),
    )
  # Convert formulas to formula objects
    formula_list <- lapply(formula_list, as.formula)
    
    # Model indexing
    model_index <- 1

   #initialise lists for models
   model_results <- list()
