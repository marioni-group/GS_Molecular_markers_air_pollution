library(tidyverse)
library(data.table)

#______________________________________________________________________________________________________
#all-cause mortality

#load deaths data
deaths1 <- fread(here("deaths.csv"))

#Load coxdf
cvd_df <- fread("coxdf_bmifilt.csv")
mort_df <- cvd_df

#Recode censoring date & status
mort_df <- mort_df %>%
  mutate(status_mort = ifelse(dod_ym < censor_date, "1", "0"))
table(mort_df$status_mort)

#set no death to 0
mort_df <- mort_df %>%
  mutate(status_mort = coalesce(status_mort, "0"))


#Update event date & tte
mort_df <- mort_df %>%
  mutate(event_date = pmin(censor_date, dod_ym, na.rm = TRUE)) #event date is the earliest out of death/censor
sapply(mort_df, function(x) sum(is.na(x)))

#.2 TTE
mort_df <- mort_df %>%
  mutate(tte = difftime(event_date, appt2, units = "days"))

  #update tte_years

mort_df <- mort_df %>%
  mutate(tte_years = as.numeric(tte)/365.25)

#add covariates
cov <- fread("pheno.csv")
pollution <- fread("annual_avg_exp_foranalysis_ntr.csv")
diseases <- fread("2025-01-09_diseases.csv")

#Now create flags for prevalent diabetes & prevalent HTN
flags <- diseases %>% 
  filter(id %in% mort_df$id) %>%
  mutate(diabetes = ifelse(incident == "0" & disease == "diabetes" & source == "Secondary_Care", "1", "0"),
         hypertension = ifelse(incident == "0" & disease == "hypertension" & source == "Secondary_Care", "1", "0"))

flags2 <- flags %>%
  select(id, diabetes, hypertension) %>%
  filter(id %in% mort_df$id) %>%
  filter(diabetes == "1" | hypertension == "1")

flags2 <- flags2 %>%
 group_by(id) %>%
 summarise(
  diabetes = max(as.numeric(diabetes)),
  hypertension = max(as.numeric(hypertension))
 )

#merge
mort_df2 <- left_join(mort_df, flags2, by = "id")  
mort_df2 <- mort_df2 %>%
  mutate(diabetes = coalesce(diabetes, 0),
         hypertension = coalesce(hypertension, 0))  

#Add in pollution
#add pollutants too
pollution2 <- pollution %>% 
  dplyr::rename(id = ID) %>%
  dplyr::filter(id %in% mort_df2$id) %>%
  dplyr::select(id, Pollutant, days_365_avg) %>%
  pivot_wider(
    names_from = Pollutant,
    values_from = days_365_avg
  )

mort_df2$id <- as.character(mort_df2$id)
pollution2$id <- as.character(pollution2$id)
mort_df2 <- left_join(mort_df2, pollution2, by = "id")

#add in final covariates
cov2 <- cov %>% dplyr::filter(id %in% mort_df2$id) %>%
  dplyr::select(id, units, simd2009v2rank) %>%
  mutate(id = as.character(id))


mort_df2 <- left_join(mort_df2, cov2, by = "id") 

#transform variables
#set up for imputation
mort_df2$id <- as.character(mort_df2$id)
mort_df2$sex <- as.factor(mort_df2$sex)
mort_df2$y_appt <- as.factor(mort_df2$y_appt)
mort_df2$logsmok <- log10(mort_df2$pack_years + 1)
mort_df2$logunits <- log10(mort_df2$units + 1)
mort_df2$logbmi <- log10(mort_df2$bmi)
mort_df2$age <- as.character(mort_df2$age) #so can centre without scaling
mort_df2$diabetes <- as.character(mort_df2$diabetes)
mort_df2$hypertension <- as.character(mort_df2$hypertension)
str(mort_df2)

#Scale - required prior to knn imputation
mort_df2 <- mort_df2 %>% modify_if(., is.numeric, scale)
mort_df2$age <- scale(as.numeric(mort_df2$age), scale = FALSE) #centre but don't scale age
str(mort_df2)

#Check if any rows/columns have missing data > 0.4
mort_df2 <- mort_df2 %>% dplyr::select(-c(pack_years, units, bmi)) #remove phenotypes which have been log transformed
max_missing <- 0.6
rows_with_high_missing <- which(rowMeans(is.na(mort_df2)) > max_missing) 
rows_with_high_missing 
cols_with_high_missing <- which(colMeans(is.na(mort_df2)) > max_missing)
cols_with_high_missing

#Impute missing data
library(VIM)
set.seed(12)

variables <- c("simd2009v2rank", "logsmok", "logunits", "logbmi")
mort_df2 <- VIM::kNN(as.data.frame(mort_df2), variable = variables,  k = 5)
mort_df2$status_mort <- as.numeric(mort_df2$status_mort)


#Create high vs low pollutants 
for (pollutant in pollutants) {
  mort_df2 <- mort_df2 %>%
    mutate(
      !!paste0(pollutant, "d") := cut(
        .data[[pollutant]], 
        breaks = quantile(.data[[pollutant]], probs = 0:2 / 2, na.rm = TRUE),
